{
  "name": "magpie-fingerprint",
  "version": "0.1.2",
  "description": "Model fingerprint diagnostics for Magpie, powered by lm-detector",
  "type": "module",
  "license": "MIT",
  "main": "dist/plugin.js",
  "files": [
    "dist",
    "page",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "integration.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build",
    "format": "prettier --write src web scripts tests page *.json *.ts *.md",
    "prepack": "bun run build"
  },
  "magpie": {
    "page": {
      "title": "Fingerprint",
      "titles": {
        "zh": "模型指纹"
      },
      "file": "page/index.html",
      "service": {
        "port": 3488,
        "option": "port"
      }
    },
    "actions": [
      {
        "id": "fingerprint",
        "menu": "provider",
        "title": "Fingerprint",
        "titles": {
          "zh": "检测指纹"
        }
      }
    ],
    "options": {
      "port": 3488
    }
  },
  "dependencies": {
    "lmfpd-sdk": "0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KaranocaVe/magpie-fingerprint.git"
  },
  "bugs": {
    "url": "https://github.com/KaranocaVe/magpie-fingerprint/issues"
  }
}
